# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# MySQL 8 for conversations and spend. The tables are created on startup.
# Locally: `docker compose up -d mysql` starts one that matches this URL.
MYSQL_URL=mysql://root:aiapp@127.0.0.1:3306/ai_app

# "<provider>:<model>". Swap models here without touching code.
# CHAT_MODEL=google:gemini-3.8-flash

# Optional override of the assistant's system prompt.
# SYSTEM_PROMPT=
