# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# MySQL 8 for conversations and spend. The tables are created on startup.
# Locally: `docker compose up -d mysql` starts one that matches this URL.
MYSQL_URL=mysql://root:aiapp@127.0.0.1:3306/ai_app

# Days a conversation is kept after its last message (0 = forever). Spend records are kept.
# RETENTION_DAYS=30

# Default "<provider>:<model>" for new chats, titles and scheduled runs (default google:gemini-3.5-flash-lite).
# The composer lets a chat switch between the models listed in lib/model-catalog.ts.
# CHAT_MODEL=google:gemini-3.5-flash-lite

# Optional override of the assistant's system prompt.
# SYSTEM_PROMPT=

# Wanderlog tools (unofficial wanderlog-mcp). The `connect.sid` cookie of a logged-in
# wanderlog.com session (starts with s%3A); treat it like a password. Leave empty to disable.
# For local dev run `npm ci` in mcp-servers/ first.
# WANDERLOG_COOKIE=

# Extra MCP servers as JSON, e.g. a remote one:
# MCP_SERVERS={"notes":{"url":"https://notes.example.com/mcp","headers":{"Authorization":"Bearer ..."}}}
# Tool results longer than this many characters are truncated (default 8000).
# MCP_MAX_RESULT_CHARS=8000

# IANA time zone that scheduled prompts' cron expressions and "now" use (default UTC).
# SCHEDULE_TIMEZONE=Asia/Jerusalem
